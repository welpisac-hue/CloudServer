# ============================================================
# Pulse Control Panel — LOCAL environment (do not commit)
# Fill these in for localhost testing with: python server.py
# Mirror the same keys in Vercel → Project → Settings → Environment Variables
# ============================================================

# Admin login (required) — used by /api/admin/login, NEVER hardcoded in source
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Random long secret for session integrity (generate any long random string)
SESSION_SECRET=

# Supabase (required for production / Vercel; optional for pure local JSON mode)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional anon key if you add client-side Supabase later
SUPABASE_ANON_KEY=

# Security hardening (optional)
# Comma-separated IPs allowed to log into the panel (empty = allow any IP after login)
ADMIN_IP_ALLOWLIST=
MAX_LOGIN_FAILURES=5
LOGIN_LOCKOUT_SECONDS=900
SESSION_TTL_SECONDS=86400

# Local server
PORT=3000
# false for localhost http cookies; true (default) on Vercel/HTTPS
COOKIE_SECURE=false
CORS_ORIGIN=*
