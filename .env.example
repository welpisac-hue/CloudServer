# ============================================================
# Pulse Control Panel — environment template (safe to commit)
# Copy to .env for local:  copy .env.example .env
# Mirror the SAME keys in Vercel → Project → Settings → Environment Variables
# (Production + Preview)
# ============================================================

# Admin login (REQUIRED) — never hardcode in source
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Long random secret (REQUIRED in production). Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=

# Supabase (REQUIRED for Vercel production)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Optional — not used by the server today (kept for future client tooling)
SUPABASE_ANON_KEY=

# Lock admin login to your IPs (recommended in production)
# Example: ADMIN_IP_ALLOWLIST=1.2.3.4,5.6.7.8
ADMIN_IP_ALLOWLIST=

MAX_LOGIN_FAILURES=5
LOGIN_LOCKOUT_SECONDS=900
SESSION_TTL_SECONDS=86400

# Local server only
PORT=3000
# false for localhost http; true (default) on Vercel HTTPS
COOKIE_SECURE=false

# Exact site origin(s) for credentialed CORS — set to your Vercel URL after deploy
# Example: CORS_ORIGIN=https://pulse-panel.vercel.app
# Leave empty to reflect the request Origin (ok for same-origin panel)
CORS_ORIGIN=

# Release storage soft caps
STORAGE_SOFT_CAP_BYTES=524288000
STORAGE_WARN_BYTES=419430400
STORAGE_CRIT_BYTES=503316480
STORAGE_WARN_COUNT=8
STORAGE_CRIT_COUNT=12
